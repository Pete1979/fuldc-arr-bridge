# --- FulDC++ Web API ---------------------------------------------------------
# On the same Windows PC as FulDC++ (Docker Desktop): keep host.docker.internal.
# On another machine: use the LAN IP, e.g. http://192.168.0.22:5600
FULDC_URL=http://host.docker.internal:5600
FULDC_USER=admin
FULDC_PASS=change-me

# --- Where downloads go (a Windows path, as FulDC++ sees it) ------------------
# REQUIRED: set this to YOUR DC share root. It's whatever drive/folder your
# FulDC++ shares from - e.g. S:\dc, D:\Media, E:\Shares\DC ...
#   movies  -> DC_ROOT\movies\
#   series  -> DC_ROOT\series\<Show>\S<NN>\
DC_ROOT=S:\dc

# Optional: override the movie / TV folders directly (full Windows paths) if
# your layout isn't <root>\movies and <root>\series. Leave blank to use DC_ROOT.
#MOVIES_DIR=
#SERIES_DIR=

# 1 = only movies, 0 = movies + TV
MOVIES_ONLY=0

# Preferred quality, e.g. 1080p. It's a preference, not a hard filter: a matching
# release is always chosen over a lower one, but when none is shared the best
# available quality (or an untagged pack, e.g. anime) is grabbed. TV episode
# monitors still bake it in. Blank = no preference.
QUALITY=

# --- Kids routing (optional) -------------------------------------------------
# Send kids shows/movies to dedicated folders based on their genre. Needs a
# metadata source: EITHER a free TMDB API key, OR your Seerr instance's API key.
# Default kids folders are DC_ROOT\kids.movies and DC_ROOT\kids.series.
# Set KIDS_ROUTING=0 to disable. KIDS_GENRES defaults to "Kids,Family"
# (Animation alone is NOT treated as kids, so adult cartoons stay in movies/series).
KIDS_ROUTING=1
#TMDB_API_KEY=
# ...or reuse your Seerr/Jellyseerr/Overseerr:
#SEERR_URL=http://seerr:5055
#SEERR_API_KEY=
#KIDS_MOVIES_DIR=
#KIDS_SERIES_DIR=
#KIDS_GENRES=Kids,Family

# --- Auto new-season detection (optional) ------------------------------------
# Periodically check for NEW seasons of shows you already follow (live %[inc]
# monitors AND your Seerr TV requests, so pack-grabbed shows are covered too)
# and start a %[inc] monitor automatically — so a returning series keeps
# downloading without a fresh Seerr request. Needs a metadata source above.
# Aired seasons are the UNION of TMDB and TVmaze (keyless): TMDB lags on
# announcing new seasons of continuing shows, TVmaze often has them first.
# Hours between checks; 0 = off.
SEASON_CHECK_HOURS=0

# Also follow every series in your media-server library (not just Seerr
# requests) — so a show you OWN but never re-requested still gets new seasons.
# Needs MEDIASERVER=plex (PLEX_URL/PLEX_TOKEN) or jellyfin (JELLYFIN_URL/TOKEN)
# below; with neither it harmlessly falls back to Seerr requests + monitors.
#MONITOR_LIBRARY=1

# Only auto-grab a NEW season if it aired within this many days — older aired
# seasons of a show you're behind on are backfill (request via Seerr), not a
# new drop. Keeps an ended show from having its whole tail pulled in.
#SEASON_RECENT_DAYS=540

# Make deleting a show from your share the single 'stop following' switch: when
# a followed show's folder is gone from the share, its %[inc] episode monitor is
# removed on the next sweep (only if it had grabbed episodes and nothing is
# downloading into it). Off by default; the monitor otherwise keeps running.
#PRUNE_UNSHARED=1

# Optional: POST a small JSON ping here when a new season is detected
# ({event, show, season, mode, target}). Wire it to Discord/ntfy/HA/etc.
#SEASON_NOTIFY_WEBHOOK=

# --- Webhook security --------------------------------------------------------
# Anyone who can reach port 8080 can queue downloads on your machine. Set a
# random string here and append it to the Seerr webhook URL:
#   http://<host>:8080/?token=<value>
# Leave blank only if the port is strictly LAN-internal.
#WEBHOOK_TOKEN=

# --- Optional: refresh your media server right after a download --------------
# plex | jellyfin | webhook | none  (most servers rescan periodically anyway)
MEDIASERVER=none
#PLEX_URL=http://192.168.0.22:32400
#PLEX_TOKEN=
#PLEX_MOVIES_SECTION=Movies
#PLEX_SERIES_SECTION=TV Shows
#JELLYFIN_URL=http://192.168.0.22:8096
#JELLYFIN_TOKEN=
#NOTIFY_WEBHOOK=

# --- EXPERIMENTAL: Radarr/Sonarr integration (docker compose --profile arr) ---
# REQUIRED with --profile arr: the arr server refuses to start without it.
# Use the same value as the indexer API key in Radarr/Sonarr.
#TORZNAB_APIKEY=changeme
# Credentials for the qBittorrent-compatible download client (same values go in
# the Radarr/Sonarr download-client config). Blank = no authentication.
#QBIT_USER=admin
#QBIT_PASS=
